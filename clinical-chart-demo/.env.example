# Control plane
HEBRAH_API_BASE_URL=http://localhost:8000
HEBRAH_SANDBOX_API_KEY=hb_test_your_key_here
HEBRAH_WEBHOOK_SECRET=hbsec_your_secret_here

# Connection for connection-scoped resource IDs (from hebrah dashboard)
