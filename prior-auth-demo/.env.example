# Webhook verification (from hebrah onboarding)
HEBRAH_WEBHOOK_SECRET=hbsec_your_secret_here

# Public URL for webhook registration
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Hosted hebrah MCP (hebrah-mcp-host)
HEBRAH_MCP_URL=http://localhost:3021/mcp
HEBRAH_PAT=hb_pat_your_token_here
HEBRAH_CONNECTION_ID=conn-sa-your_connection_id
HEBRAH_DEFAULT_PATIENT_ID=pat_00000000_01

