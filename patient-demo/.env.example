# Control plane (hebrah-api locally, api.hebrah.com in production)
HEBRAH_API_BASE_URL=http://localhost:8000

# From hebrah onboarding Step 2 — never commit real values
HEBRAH_SANDBOX_API_KEY=hb_test_your_key_here
HEBRAH_WEBHOOK_SECRET=hbsec_your_secret_here

# Optional — system sandbox connection from onboarding (conn-sa-...)
# When set, mock event triggers default to connection-scoped patient IDs from catalog
HEBRAH_CONNECTION_ID=conn-sa-your_connection_id

# Public URL for webhook registration (must match how hebrah-api reaches this app)
NEXT_PUBLIC_APP_URL=http://localhost:3001
